# Copiar a .env y completar. NUNCA versionar .env.

# --- Base de datos (PostgreSQL local en Compose o Supabase en despliegue) ---
POSTGRES_USER=kahoot
POSTGRES_PASSWORD=cambiar_esto
AUTH_DATABASE_URL=postgresql://kahoot:cambiar_esto@postgres:5432/auth
KAHOOT_DATABASE_URL=postgresql://kahoot:cambiar_esto@postgres:5432/kahoot
# En Supabase usar la URL del pooler con ?sslmode=require
DATABASE_SSL=false

# --- auth-api ---
AUTH_PORT=3001
# Claves RS256 en PEM con los saltos de linea escritos como \n.
# Generar un par con: npm run keys:generate -w @profelink/auth-api
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-key-1
JWT_EXPIRES_IN=1h
# Audiencia que reconoce kahoot-api
JWT_AUDIENCE=kahoot-api
JWT_ISSUER=auth-api

# --- kahoot-api ---
KAHOOT_PORT=3002
AUTH_BASE_URL=http://auth-api:3001
# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
QUESTION_TIME_SECONDS=20
# disk | supabase
IMAGE_STORAGE=disk
IMAGE_STORAGE_PATH=/data/images
# Maximo 2097152 (2 MiB)
IMAGE_MAX_BYTES=2097152
# URL publica de kahoot-api (se usa para construir imageUrl)
PUBLIC_API_URL=http://localhost:3002
# Solo si IMAGE_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=question-images

# --- Datos de demostracion (seed) ---
# El mismo DEMO_PROFILE_ID debe usarse en auth-api y kahoot-api.
DEMO_PROFILE_ID=00000000-0000-4000-8000-000000000001
DEMO_EMAIL=docente.demo@example.com
DEMO_DISPLAY_NAME=Docente demo
# Minimo 8 caracteres con letras y numeros. No versionar el valor real.
DEMO_PASSWORD=

# --- web (Vite) ---
VITE_AUTH_API_URL=http://localhost:3001
VITE_KAHOOT_API_URL=http://localhost:3002

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esto

# --- Imagenes Docker Hub ---
DOCKERHUB_USER=tu_usuario
IMAGE_TAG=latest
