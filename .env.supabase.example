# Copia a .env.supabase (no se versiona) para usar Supabase desde tu maquina.
# Pooler de sesion (puerto 5432). Si la contrasena tiene @ # / u otros simbolos, codificalos (@ -> %40).
SUPABASE_DATABASE_URL=postgresql://postgres.fefdufzdjdhcqwvofyuc:CAMBIAR_CONTRASENA@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# Certificado raiz de Supabase (Project Settings > Database > SSL Configuration), PEM en una linea con \n.
SUPABASE_SSL_CA=
