{
  "name": "@profelink/kahoot-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schemas.cjs",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node scripts/test.cjs",
    "test:integration": "node scripts/test.cjs test/integration.spec.ts test/live.spec.ts",
    "migration:run": "tsx src/data/migrate.ts",
    "seed": "tsx src/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/websockets": "^11.2.10",
    "socket.io": "^4.8.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@nestjs/swagger": "^11.4.8",
    "@scalar/nestjs-api-reference": "^1.2.37",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20",
    "yaml": "^2.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "socket.io-client": "^4.8.4",
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  }
}
