# Copiar a .env y completar. NUNCA versionar .env.
# Lo normal es ejecutar ./start.sh (Linux/macOS) o .\start.ps1 (Windows): crean .env desde este
# archivo y generan las contrasenas que falten.

# --- Proyecto de Compose ---
# start.sh / start.ps1 lo fijan solos (rubymind-<nombre de la carpeta>) para que dos copias del repositorio
# en la misma maquina no se pisen. Si dos copias corren a la vez, cada una necesita puertos distintos
# (WEB_PORT, AUTH_PORT, KAHOOT_PORT y GRAFANA_PORT) y su PUBLIC_URL.
# COMPOSE_PROJECT_NAME=

# --- Acceso ---
# URL con la que los navegadores abren la aplicacion. Para jugar desde otros dispositivos de la
# red, usar la IP de esta maquina, por ejemplo http://192.168.1.20:8080
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Interfaz donde se publica la web (0.0.0.0 = accesible desde la red local)
WEB_BIND=0.0.0.0
# Interfaz de las APIs publicadas para consumo independiente y documentacion (127.0.0.1 = solo esta maquina)
API_BIND=127.0.0.1
AUTH_PORT=3001
KAHOOT_PORT=3002

# --- Base de datos (PostgreSQL local en Compose; en Supabase se usan las URLs del despliegue) ---
POSTGRES_USER=kahoot
# start.sh / start.ps1 reemplazan este valor por uno aleatorio si dice cambiar_esto
POSTGRES_PASSWORD=cambiar_esto

# --- auth-api ---
# Dejar vacias las claves: se generan la primera vez y se guardan en un volumen.
# (Para usar claves propias: PEM con los saltos de linea escritos como \n)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-key-1
JWT_EXPIRES_IN=1h
# Token efímero de invitado; no crea perfil en la base de datos.
JWT_GUEST_EXPIRES_IN=6h
# Audiencia que reconoce kahoot-api
JWT_AUDIENCE=kahoot-api
JWT_ISSUER=auth-api

# --- kahoot-api ---
# Origenes permitidos por CORS (separados por coma). Si se omite, se usa PUBLIC_URL.
# Para consumir las APIs desde OTRO origen (por ejemplo el cliente externo de apps/external-client en
# http://localhost:5174) hay que listarlo aqui junto con PUBLIC_URL; cualquier otro origen queda bloqueado:
# CORS_ORIGINS=http://localhost:8080,http://localhost:5174
QUESTION_TIME_SECONDS=20
# Maximo 2097152 (2 MiB)
IMAGE_MAX_BYTES=2097152
# Eventos por segundo y por conexion antes de desconectar al cliente
LIVE_MAX_EVENTS_PER_SECOND=20

# --- Datos de demostracion (seed) ---
# El mismo DEMO_PROFILE_ID lo usan auth-api y kahoot-api.
DEMO_PROFILE_ID=00000000-0000-4000-8000-000000000001
DEMO_EMAIL=docente.demo@example.com
DEMO_DISPLAY_NAME=Docente demo
# Minimo 8 caracteres con letras y numeros. start.sh / start.ps1 generan uno si esta vacio.
DEMO_PASSWORD=

# --- web ---
# Mostrar el boton "simular reconexion" (solo para la demostracion en clase). Requiere reconstruir la imagen.
VITE_ENABLE_DEBUG_CONTROLS=false

# --- Observabilidad (perfil "observability") ---
# Lo activa start.sh --observability; con el perfil apagado debe quedar vacio.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# start.sh / start.ps1 reemplazan este valor por uno aleatorio si dice cambiar_esto
GRAFANA_ADMIN_PASSWORD=cambiar_esto

# --- Imagenes de Docker Hub ---
DOCKERHUB_USER=aaronsc04
IMAGE_TAG=latest

# --- Despliegue en la nube (Supabase + Render): no se usan con Compose ---
# AUTH_DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres?sslmode=require
# KAHOOT_DATABASE_URL=postgresql://...
# DATABASE_SSL=true
# IMAGE_STORAGE=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=question-images

# --- Desarrollo local sin Docker (npm run dev -w @rubymind/web) ---
# VITE_AUTH_API_URL=http://localhost:3001
# VITE_KAHOOT_API_URL=http://localhost:3002

# Segundos tras cerrar una pregunta para pasar sola a la siguiente (0 la desactiva; el anfitrion siempre puede avanzar antes).
# AUTO_ADVANCE_SECONDS=5
