{
  "name": "@rubymind/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node e2e/run-live-e2e.mjs",
    "test:e2e:pw": "playwright test -c playwright.config.mjs",
    "gen:api": "openapi-typescript ../../packages/contracts/openapi/auth-api.yaml -o src/api/generated/auth-api.d.ts && openapi-typescript ../../packages/contracts/openapi/kahoot-api.yaml -o src/api/generated/kahoot-api.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "i18next": "^24.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
