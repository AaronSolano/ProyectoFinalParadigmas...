{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profelink.local/contracts/events/schemas/question-closed.schema.json",
  "title": "question:closed",
  "description": "Servidor -> sala. La pregunta se cerró (por plazo o por el anfitrión). ÚNICO evento que lleva correctOption. results incluye a todos los participantes.",
  "type": "object",
  "properties": {
    "questionIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "Índice de la pregunta, base 0."
    },
    "correctOption": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Índice (base 0) de la opción correcta."
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300,
      "description": "Explicación breve de la respuesta que escribió el docente; null si la pregunta no tiene. Solo viaja al cerrar la pregunta."
    },
    "nextQuestionAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Instante (reloj del servidor) en que la sala pasará sola a la siguiente pregunta; null si el avance automático está desactivado. El anfitrión puede avanzar antes."
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "question-result.schema.json"
      }
    },
    "ranking": {
      "type": "array",
      "items": {
        "$ref": "ranking-entry.schema.json"
      }
    }
  },
  "required": [
    "questionIndex",
    "correctOption",
    "explanation",
    "nextQuestionAt",
    "results",
    "ranking"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "questionIndex": 0,
      "correctOption": 1,
      "explanation": "San José es la capital desde 1823.",
      "nextQuestionAt": "2026-11-15T15:00:35.000Z",
      "results": [
        {
          "participantId": "5b0f6c1e-5c1e-4b53-9d2a-0a6f5e8d1a11",
          "answered": true,
          "correct": true,
          "pointsAwarded": 1000,
          "elapsedMs": 320,
          "streak": 1,
          "totalScore": 1000
        },
        {
          "participantId": "8c2d3f40-1a7b-4e9c-b3d5-6e7f8a9b0c12",
          "answered": false,
          "correct": false,
          "pointsAwarded": 0,
          "elapsedMs": null,
          "streak": 0,
          "totalScore": 0
        }
      ],
      "ranking": [
        {
          "position": 1,
          "participantId": "5b0f6c1e-5c1e-4b53-9d2a-0a6f5e8d1a11",
          "displayName": "Ana",
          "score": 1000
        },
        {
          "position": 2,
          "participantId": "8c2d3f40-1a7b-4e9c-b3d5-6e7f8a9b0c12",
          "displayName": "Beto",
          "score": 0
        }
      ]
    }
  ]
}
