    "@scalar/nestjs-api-reference": "^1.2.37",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
