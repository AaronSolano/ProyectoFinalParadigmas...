# Normaliza finales de linea. Los archivos que se ejecutan o se copian a contenedores Linux
# deben conservar LF aunque el repositorio se clone en Windows.
* text=auto
*.sh text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf
*.alloy text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf
