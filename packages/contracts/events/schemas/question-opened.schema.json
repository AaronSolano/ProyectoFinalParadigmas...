{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profelink.local/contracts/events/schemas/question-opened.schema.json",
  "title": "question:opened",
  "description": "Servidor -> sala. Pregunta abierta. No incluye la respuesta correcta.",
  "type": "object",
  "properties": {
    "questionIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "Índice de la pregunta, base 0."
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "statement": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "description": "Opciones de respuesta (2 a 4) en el orden en que se muestran. Verdadero/Falso es una pregunta de 2 opciones."
    },
    "imageUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "closesAt": {
      "type": "string",
      "format": "date-time"
    },
    "serverTime": {
      "type": "string",
      "format": "date-time"
    },
    "openedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Instante de apertura según el reloj del servidor."
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240,
      "description": "Duración total de la pregunta en segundos (closesAt - openedAt)."
    }
  },
  "required": [
    "questionIndex",
    "total",
    "statement",
    "options",
    "imageUrl",
    "closesAt",
    "serverTime",
    "openedAt",
    "durationSeconds"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "questionIndex": 0,
      "total": 5,
      "statement": "¿Cuál es la capital de Costa Rica?",
      "options": [
        "Alajuela",
        "San José",
        "Cartago",
        "Heredia"
      ],
      "imageUrl": "http://localhost:3002/api/v1/images/9b2f1c4e-2d6a-4a53-8f0e-1a7d5c3b9e10.png",
      "closesAt": "2026-11-15T15:00:30.000Z",
      "serverTime": "2026-11-15T15:00:00.000Z",
      "openedAt": "2026-11-15T15:00:00.000Z",
      "durationSeconds": 30
    }
  ]
}
