FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS dependencies
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/auth-api/package.json ./apps/auth-api/package.json
COPY apps/kahoot-api/package.json ./apps/kahoot-api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
# Requires the root lockfile regenerated by the orchestrator after F4 is merged.
RUN npm ci --workspaces --include-workspace-root

FROM dependencies AS auth
WORKDIR /repo/apps/auth-api
COPY apps/auth-api/tsconfig.json ./
COPY apps/auth-api/src ./src
COPY packages/contracts /repo/packages/contracts
RUN npm run build
COPY apps/kahoot-api/test/start-auth.cjs ./start-test.cjs
USER node
CMD ["node", "start-test.cjs"]

FROM dependencies AS kahoot
WORKDIR /repo/apps/kahoot-api
COPY apps/kahoot-api/tsconfig.json ./
COPY apps/kahoot-api/src ./src
COPY apps/kahoot-api/scripts ./scripts
COPY apps/kahoot-api/assets ./assets
COPY packages/contracts /repo/packages/contracts
RUN npm run build
USER node
CMD ["node", "dist/main.js"]
