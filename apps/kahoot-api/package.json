{
  "name": "@profelink/kahoot-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node --experimental-vm-modules -e \"require('jest').run(['--runInBand'])\"",
    "migration:run": "tsx src/data/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
